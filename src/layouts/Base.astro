---
import Social from '../components/Social.astro';
import { img, sized } from '../data/images';
import '../styles/global.css';

interface Props { title: string; description?: string; ogTitle?: string; ogDescription?: string; header?: 'cream' | 'white' | 'green' | 'dark'; ogType?: string; ogImage?: string; extraLd?: object[]; }
const { title, description = '', ogTitle = title, ogDescription = description, header = 'cream', ogType = 'website', ogImage, extraLd = [] } = Astro.props;
let path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = 'https://www.socipizza.com' + (path || '/');
const nav = [
  ['Weddings', '/weddings'], ['Parties', '/parties'], ['Corporate', '/corporate'], ['Pricing', '/pricing'],
  ['Menu', '/catering-menu'], ['FAQ', '/faq'], ['About', '/about'],
];
const ldWebsite = { url: 'https://www.socipizza.com', name: 'Soci Pizza', description: '', image: 'https://www.socipizza.com' + img.logo, '@context': 'http://schema.org', '@type': 'WebSite' };
const ldBusiness = { address: '', image: 'https://www.socipizza.com/images/localbusiness-image.webp', openingHours: '', '@context': 'http://schema.org', '@type': 'LocalBusiness' };
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sized(img.favicon, 100)} />
    <meta property="og:site_name" content="Soci Pizza" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={'https://www.socipizza.com' + (ogImage || img.ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldBusiness)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <!-- Google Ads (same account as the Squarespace site) -->
    <!-- Microsoft Clarity -->
    <script>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "ts98ld6h67");
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17667807917"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17667807917');
      gtag('config', 'G-0P88MP71XM');
    </script>
    <script is:inline>
      // Remember where a visitor first came from (kept 90 days) so booking emails show the source.
      (function () {
        try {
          var KEY = 'soci_src', now = Date.now(), old = JSON.parse(localStorage.getItem(KEY) || 'null');
          var q = new URLSearchParams(location.search), ref = document.referrer, host = '';
          try { host = ref ? new URL(ref).hostname : ''; } catch (e) {}
          if (host.indexOf('socipizza') > -1 || host.indexOf('vercel.app') > -1) host = '';
          var utm = (q.get('utm_source') || '').toLowerCase(), med = (q.get('utm_medium') || '').toLowerCase();
          var src = '';
          if (q.get('gclid') || q.get('gbraid') || q.get('wbraid') || med === 'cpc' || med === 'ppc') src = 'Google Ads';
          else if (/instagram/.test(utm + host)) src = 'Instagram';
          else if (/facebook|^fb$|fb\.com/.test(utm + ' ' + host) || q.get('fbclid')) src = 'Facebook';
          else if (/youtube|youtu\.be/.test(utm + host)) src = 'YouTube';
          else if (/tiktok/.test(utm + host)) src = 'TikTok';
          else if (utm) src = utm;
          else if (/(^|\.)google\./.test(host)) src = 'Google Organic';
          else if (/bing|duckduckgo|yahoo/.test(host)) src = 'Other search (' + host + ')';
          else if (host) src = 'Referral (' + host + ')';
          var fresh = !old || now - old.t > 90 * 864e5;
          if (fresh || (src && src !== 'Direct' && old.src === 'Direct')) {
            localStorage.setItem(KEY, JSON.stringify({ src: src || 'Direct', landing: location.pathname, t: now }));
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={`hdr-${header}`}>
    <div class="announce" id="announce">
      <p><strong>2026/27 weekends are filling fast. </strong><a href="/book-now"><strong>Book now</strong></a><strong>.</strong></p>
      <button type="button" aria-label="Close Announcement" onclick="document.getElementById('announce').remove()">×</button>
    </div>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="logo"><img src={sized(img.logo, 500)} alt="Soci Pizza" width="120" height="60" /></a>
        <nav class="main-nav" aria-label="Main">
          {nav.map(([label, href]) => <a href={href} class={path === href ? 'active' : undefined} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
          <a href="/book-now" class="btn btn-sm">Book now</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Open menu"><span></span><span></span></summary>
          <nav aria-label="Mobile">
            {nav.map(([label, href]) => <a href={href}>{label}</a>)}
            <a href="/book-now">Book Now</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="page">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p>Read the <a href="/about">Soci Pizza story</a>, or follow the <a href="/blog">Soci Pizza blog</a> for pizza truck catering tips.</p>
          <Social />
        </div>
        <div>
          <p>Based in Pittsboro, NC. Proudly serving Raleigh-Durham, Charlotte &amp; select North Carolina destinations. 🇺🇸</p>
        </div>
        <div>
          <p>Questions? <a href="/faq">Visit our FAQ</a> or contact book@socipizza.com.</p>
          <p>For booking inquiries, submit a form via our <a href="/book-now">Book Now page</a> or call us at <a href="tel:6672904315">(667) 290-4315</a>.</p>
          <p><a href="/terms-conditions">Terms &amp; Conditions</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
