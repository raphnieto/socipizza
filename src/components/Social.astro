<div class="social">
  {links.map((l) => (
    <a href={l.href} target="_blank" rel="noopener" aria-label={l.name}>
      <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={l.d} /></svg>
    </a>
  ))}
</div>
<style>
  .social { display: flex; gap: 12px; align-items: center; }
  .social a { color: inherit; display: inline-flex; }
</style>
