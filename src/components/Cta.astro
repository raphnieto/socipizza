---
const { bg = 'bg-black', btn = 'btn-white' } = Astro.props;
---
<section class={`cta ${bg}`}>
  <div class="wrap cta-grid">
    <div>
      <h1><strong>Reserve your date with Soci Pizza ❤️</strong></h1>
      <h4><strong>No hidden fees, upfront pricing, and a guaranteed commitment.</strong> Get in touch today and elevate your event.</h4>
    </div>
    <div class="cta-btn"><a href="/book-now" class={`btn btn-lg ${btn}`}>Book Now</a></div>
  </div>
</section>
<style>
  .cta { padding: 5.7vw 0; }
  .cta-grid { display: grid; grid-template-columns: 45.6vw 1fr; align-items: center; gap: 4vw; }
  .cta h1 { margin-bottom: 0.25em; }
  .cta h4 { margin: 0; }
  .cta-btn { display: flex; justify-content: center; }
  @media (max-width: 860px) { .cta-grid { grid-template-columns: 1fr; } .cta { padding: 56px 0; } }
</style>
