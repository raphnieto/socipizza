---
// Shared layout for /weddings, /parties, /corporate (same Squarespace template)
import Rating from './Rating.astro';
import PricingSection from './PricingSection.astro';
import Instagram from './Instagram.astro';
import Faq from './Faq.astro';
import Cta from './Cta.astro';

interface P {
  hero: { img: string; alt: string; h1: string; h4: string; btn: string; note: string; wide?: boolean; tall?: boolean };
  reviews: { h2: string; h3: string; lastLink?: string };
  five: { h2: string; h3: string; img: string; alt?: string; narrow?: boolean; aspect: string; reasons: [string, string][] };
  instaSub: string;
  faq: { title: string; items: [string, string][]; more?: string };
}
const { hero, reviews, five, instaSub, faq } = Astro.props as P;
const rv = [
  { name: 'Annmarie Klapper', img: '/images/annie-soci-pizza-customer-in-chapel-hill-nc.webp', quote: '“Enchanting, delicious. An experience that instantly elevates any gathering.”', href: 'https://share.google/VZ2poGUfvyTA4J0fn', cls: 'rv-yellow', link: 'Read full Google review' },
  { name: 'Ruth Stewart', img: '/images/ruth-steward-soci-pizza-catering-customer-sanford-nc.webp', quote: '“Had a great experience with Soci Pizza. The pizza is divine. Highly recommend!”', href: 'https://share.google/VZ2poGUfvyTA4J0fn', cls: 'rv-pink', link: 'Read full Google review' },
  { name: 'Anna Pickens', img: '/images/anna-louise-pickens-headshot.webp', quote: '“We had a wonderful experience with Soci, and the Pizza was delicious!”', href: reviews.lastLink ?? 'https://share.google/VZ2poGUfvyTA4J0fn', cls: 'rv-green', link: reviews.lastLink ? 'Read full Google review' : 'Read full Google Review' },
];
---
<section class="w-hero bg-cream">
  <div class="wrap w-hero-grid">
    <div class="w-hero-img">
      <img src={hero.img} alt={hero.alt} fetchpriority="high" class={hero.tall ? 'tall' : ''} />
    </div>
    <div class="w-hero-text">
      <Rating />
      <h1 class={hero.wide ? 'wide' : ''} set:html={hero.h1} />
      <h4 set:html={hero.h4} />
      <div class="w-cta">
        <a href="/book-now" class="btn btn-lg">{hero.btn}</a>
        <p class="btn-note">{hero.note}</p>
      </div>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="wrap">
    <div class="center rv-intro">
      <h2><strong set:html={reviews.h2} /></h2>
      <h3>{reviews.h3}</h3>
    </div>
    <div class="rv-grid">
      {rv.map((r) => (
        <div class={`rv ${r.cls}`}>
          <img src={r.img} alt="" loading="lazy" />
          <h4><strong>{r.name}</strong></h4>
          <p class="rv-stars">★★★★★</p>
          <p class="rv-quote">{r.quote}</p>
          <p class="rv-link"><a href={r.href} target="_blank" rel="noopener">{r.link}</a></p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section bg-cream">
  <div class="five">
    <h2><strong>{five.h2}</strong></h2>
    <h3>{five.h3}</h3>
    <img src={five.img} alt={five.alt ?? ''} loading="lazy" class={five.narrow ? 'narrow' : ''} style={`aspect-ratio: ${five.aspect}`} />
    <div class="reasons">
      {five.reasons.map(([t, d]) => (<><h4><strong>{t}</strong></h4><p set:html={d} /></>))}
    </div>
  </div>
  <div class="five-cta">
    <a href="/book-now" class="btn btn-lg">{hero.btn}</a>
    <p class="btn-note">{hero.note}</p>
  </div>
</section>

<PricingSection bg="bg-white" id="pricing" />
<Instagram sub={instaSub} />
<Faq title={faq.title} items={faq.items} more={faq.more} />
<Cta bg="bg-yellow" btn="btn-green" />

<style>
  /* Measured from the live pages at 1200 & 1440px */
  .w-hero { padding: 40px 0 40px; }
  .w-hero-grid { display: grid; grid-template-columns: 41.75vw 41.8vw; column-gap: 4.65vw; align-items: center; }
  .w-hero-img img { width: 100%; height: calc(18.3vw + 327px); object-fit: cover; border-radius: 16px; }
  .w-hero-img img.tall { height: calc(18.3vw + 361px); }
  .w-hero:has(img.tall) { padding: 70px 0 8.7vw; }
  .w-hero-text :global(.rating), .w-hero-text h4 { max-width: 34vw; }
  .w-hero-text h1 { margin-bottom: 0.35em; max-width: 37.8vw; }
  .w-hero-text h1.wide { max-width: none; }
  .w-cta { display: flex; flex-direction: column; width: 22.5vw; margin-top: 10px; }
  .w-cta .btn { width: 100%; }
  .w-cta .btn-note { text-align: center; }

  .rv-intro { max-width: 45.3vw; margin: 0 auto 56px; }
  .rv-intro h2 { margin-bottom: 0.2em; }
  .rv-grid { display: grid; grid-template-columns: repeat(3, 22.1vw); gap: 1.25vw; justify-content: center; }
  .rv { min-height: calc(18.3vw + 153px); border-radius: 16px; padding: 31px 20px 28px; text-align: center; display: flex; flex-direction: column; align-items: center; box-shadow: 2px 3px 6px rgba(0,0,0,0.12); }
  .rv-yellow { background: #fff9e0; border: 1px solid #efe2a9; }
  .rv-pink { background: #fff0f0; border: 1px solid #f1d1d1; }
  .rv-green { background: #f4fee1; border: 1px solid #d9ebb7; }
  .rv img { width: calc(5.83vw + 5px); height: calc(5.83vw + 5px); border-radius: 50%; object-fit: cover; margin-bottom: 28px; }
  .rv h4 { margin: 0; }
  .rv-stars { color: var(--red); margin: 0 0 22px; }
  .rv-quote { font-size: 14px; line-height: 1.6; max-width: 14vw; margin: 0 0 4px; }
  .rv-link { font-size: 14px; margin: auto 0 0; }
  .rv-link a { color: var(--green); }

  .five { margin-left: 27.15vw; width: 49.5vw; }
  .five h2 { margin-bottom: 0.4em; }
  .five h3 { margin-bottom: 25px; }
  .five img { width: 100%; height: auto; object-fit: cover; border-radius: 16px; margin-bottom: 43px; }
  .five img.narrow { width: 45.6vw; }
  .reasons { max-width: 45.6vw; }
  .reasons h4 { margin: 0 0 6px; }
  .reasons p { margin: 0 0 10px; }
  .reasons :global(a) { color: var(--green); }
  .five-cta { display: flex; flex-direction: column; align-items: center; width: 22.5vw; margin: 43px auto 0; }
  .five-cta .btn { width: 100%; }
  .five-cta .btn-note { text-align: center; }

  @media (max-width: 767px) {
    /* Live order on phones: rating, title, text, landscape photo, button, note */
    .w-hero, .w-hero:has(img.tall) { padding: 28px 0 59px; }
    .w-hero-grid { display: flex; flex-direction: column; align-items: stretch; }
    .w-hero-text { display: contents; }
    .w-hero-text :global(.rating) { order: 1; margin-bottom: 7px; max-width: none; }
    .w-hero-text h1 { order: 2; margin-bottom: 10px; max-width: none; }
    .w-hero-text h4 { order: 3; margin-bottom: 10px; max-width: none; }
    .w-hero-img { order: 4; }
    .w-hero-img img, .w-hero-img img.tall { height: auto; aspect-ratio: 343 / 262; }
    .w-cta { order: 5; width: 100%; min-width: 0; margin-top: 44px; }
    .w-cta .btn-note { margin-top: 10px; }

    .rv-intro { max-width: none; margin-bottom: 46px; }
    .rv-intro h3 { max-width: 65vw; margin: 0 auto; }
    .rv-grid { grid-template-columns: 1fr; gap: 12px; }
    .rv { min-height: 300px; padding: 28px 12vw 24px; }
    .rv img { width: 76px; height: 76px; }
    .rv-quote { max-width: none; }

    .five { margin: 0 6vw; width: auto; }
    .five h3 { margin-bottom: 12px; }
    .five img, .five img.narrow { width: 100%; aspect-ratio: 343 / 330 !important; margin-bottom: 44px; }
    .reasons { max-width: none; }
    .reasons h4 { margin-bottom: 9px; }
    .reasons p { margin-bottom: 10px; }
    .five-cta { width: auto; min-width: 0; margin: 44px 6vw 0; }
  }
</style>
