---
import PricingCards from './PricingCards.astro';
const { bg = 'bg-cream', h1 = false, id } = Astro.props;
---
<section class={`section pricing ${bg}${h1 ? ' pricing-page' : ''}`} id={id}>
  <div class="wrap">
    <div class="center pricing-intro">
      {h1 ? <h1><strong>Simple, transparent, </strong><span class="red"><strong>all-inclusive pricing.</strong></span></h1>
          : <h2><strong>Simple, transparent, </strong><span class="red"><strong>all-inclusive pricing.</strong></span></h2>}
      <p class="scribble">Absolutely no hidden fees.</p>
      <h4 class="checks">✔ No surprises, clear communication.<br />✔ No wedding fee or seasonal minimums. <br />✔ <em>Most events fall between </em><strong><em>$935–$3,250.</em></strong></h4>
    </div>
    <PricingCards />
  </div>
</section>
<style>
  .pricing { padding-top: 3.5vw; }
  .pricing .wrap { padding: 0 var(--gutter); }
  .pricing-intro { max-width: 61vw; margin: 0 auto 3.6vw; }
  .pricing-intro h2, .pricing-intro h1 { margin-bottom: 0.4em; }
  .pricing-page { padding: 40px 0 14.5vw; }
  .scribble { display: inline-block; font-style: italic; font-weight: 700; border: 1.5px solid var(--red); border-radius: 50%; padding: 0 16px; margin: 0 0 1.6em; }
  .checks { margin: 0; }
  @media (max-width: 767px) {
    .pricing { padding: 35px 0 70px; }
    .pricing .wrap { padding: 0 6vw; }
    .pricing-intro { max-width: none; margin-bottom: 11px; }
    .pricing-intro h2, .pricing-intro h1 { margin-bottom: 34px; }
    .scribble { margin-bottom: 42px; }
    .pricing-page { padding-top: 28px; }
  }
</style>
