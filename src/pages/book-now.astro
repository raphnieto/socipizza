---
import Base from '../layouts/Base.astro';
import '../styles/form.css';
---
<Base
  title="Book Your Pizza Truck – Wedding & Event Pizza Catering — Soci Pizza"
  description="Ready to host something unforgettable? Book Soci Pizza for your wedding, celebration, or private event in Raleigh-Durham, Charlotte, or select North Carolina destinations. Easy form—quick response."
>
  <section class="bn bg-cream">
    <div class="bn-intro">
      <h1><strong>Reserve your date with Soci Pizza ❤️</strong></h1>
      <h4><strong>No hidden fees, upfront pricing, and a guaranteed commitment.</strong> Get in touch today and elevate your event.</h4>
    </div>
    <form class="form" data-form="booking" data-redirect="/thank-you" data-thanks="Thank you! We received your request and will get back to you shortly. ❤️">
      <h3 class="form-section">Event details</h3>
      <label>Event date <span class="req">(required)</span><input type="date" name="Event date" required /></label>
      <label>Service time <span class="req">(required)</span><small>Not sure yet? A close estimate is fine for now.</small><input name="Service time" required /></label>
      <label class="addr">Event location <span class="req">(required)</span><input name="Event location" required data-address autocomplete="off" placeholder="Start typing address or venue" /></label>
      <label>How many guests will be eating pizza? <span class="req">(required)</span><small>Helps create your quote. Estimate is totally fine.</small><input name="How many guests will be eating pizza?" required /></label>
      <fieldset class="radios"><legend>What role will Soci Pizza play? <span class="req">(required)</span></legend>
        <label><input type="radio" name="What role will Soci Pizza play?" value="Main meal" required /> Main meal</label>
        <label><input type="radio" name="What role will Soci Pizza play?" value="Additional food vendor" /> Additional food vendor</label>
        <label><input type="radio" name="What role will Soci Pizza play?" value="Not sure" /> Not sure</label>
      </fieldset>

      <h3 class="form-section">Package</h3>
      <fieldset class="radios"><legend>Which package are you interested in?</legend>
        <label><input type="radio" name="Which package are you interested in?" value="Help me choose" /> Help me choose</label>
        <label><input type="radio" name="Which package are you interested in?" value="Truck" /> Truck</label>
        <label><input type="radio" name="Which package are you interested in?" value="Tent" /> Tent</label>
        <label><input type="radio" name="Which package are you interested in?" value="Chef" /> Chef</label>
      </fieldset>

      <h3 class="form-section">Contact</h3>
      <fieldset class="row2"><legend>Name</legend>
        <label>First Name <span class="req">(required)</span><input name="First Name" required autocomplete="given-name" /></label>
        <label>Last Name<input name="Last Name" autocomplete="family-name" /></label>
      </fieldset>
      <label>Email <span class="req">(required)</span><input type="email" name="Email" required autocomplete="email" /></label>
      <label>Phone<small>Helpful if your date is in high demand.</small><input type="tel" name="Phone" autocomplete="tel" /></label>
      <label>Anything else you'd like to share?<small>More details help us quote accurately.</small><textarea name="Anything else you'd like to share?" rows="4"></textarea></label>
      <fieldset class="radios"><legend>How did you find us?<small>Help us keep doing what we love ❤️</small></legend>
        <label><input type="radio" name="How did you find us?" value="Google Ads" /> Google Ads</label>
        <label><input type="radio" name="How did you find us?" value="Google Organic" /> Google Organic</label>
        <label><input type="radio" name="How did you find us?" value="Instagram/Facebook" /> Instagram/Facebook</label>
        <label><input type="radio" name="How did you find us?" value="Youtube" /> Youtube</label>
        <label><input type="radio" name="How did you find us?" value="Other" /> Other</label>
        <input name="found_other" data-other-for="How did you find us?" placeholder="Tell us where" hidden />
      </fieldset>
      <label class="check"><input type="checkbox" name="Keep me posted" value="Yes" /> Keep me posted about Soci Pizza news</label>
      <input type="text" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="form-status" aria-live="polite"></p>
      <button type="submit" class="btn form-submit">Check availability</button>
      <p class="range">Most events range from <em>$935–$3,250+</em> depending on guest count, setup, and location.</p>
    </form>
  </section>
  <script is:inline define:vars={{ mb: import.meta.env.PUBLIC_MAPBOX_TOKEN || '' }}>window.SOCI_MAPBOX = mb;</script>
  <script is:inline src="/form.js" defer></script>
</Base>
<style>
  /* Measured from the live /book-now page (1200px) */
  .bn { padding: 70px 0 70px; }
  .bn-intro { width: 45.6vw; margin: 0 auto 15px; }
  .bn-intro h1 { margin-bottom: 0.4em; }
  .range { text-align: center; margin: 0; }
  @media (max-width: 767px) { .bn { padding: 28px 0 56px; } .bn-intro { width: auto; padding: 0 6vw; } }
</style>
