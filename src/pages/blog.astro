  .b-title { font-size: var(--fs-h3); line-height: 1.3; font-weight: 700; margin: 0 0 10px; }
  .b-title a { text-decoration: none; }
  .b-card p { font-size: 14px; margin: 0 0 39px; }
  .b-img img { width: 100%; aspect-ratio: 328 / 219; object-fit: cover; border-radius: 16px; }
  @media (max-width: 860px) { .b-top { padding: 24px 24px 0; } .b-top h2 { max-width: none; } .b-list { padding: 48px 24px; } .b-card { width: auto; } }
