---
import Base from '../layouts/Base.astro';
---
<Base
  title="Thank You | Order Now and Enjoy Fresh Pizza — Soci Pizza"
  description="Thank you for reaching out to Soci Pizza, serving the Triangle area with delicious pizza and excellent service. We'll respond within 24 hours."
>
  <section class="ty bg-cream center">
    <h1>Thank you ❤️</h1>
    <h4>Thanks for reaching out. We will get back to you in the next 24 hours. Just giving your message a little time to proof, like any good dough!</h4>
  </section>
</Base>
<style>
  .ty { padding: 110px 6vw 260px; }
  .ty h1 { margin-bottom: 0.8em; }
  .ty h4 { max-width: 61vw; margin: 0 auto; }
  @media (max-width: 767px) { .ty { padding: 80px 6vw 160px; } .ty h4 { max-width: none; } }
</style>
