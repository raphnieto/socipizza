---
import Base from '../layouts/Base.astro';
import Rating from '../components/Rating.astro';
import PricingSection from '../components/PricingSection.astro';
import Instagram from '../components/Instagram.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { img, sized } from '../data/images';

const faqs = [
  ['How far in advance should I book my pizza truck catering?', '<p>Reach out anytime, but we recommend booking our vintage pizza truck at least 2–3 months in advance, especially for weekends, weddings, and peak spring–summer dates in Raleigh-Durham, Charlotte, and select destinations across North Carolina.</p>'],
  ['What’s included in your pizza catering experience?', '<p>We’ll work with you to customize your pizza catering experience, and every package includes:</p><ul><li>Professional staff</li><li>Full setup and cleanup</li><li>Fresh Neapolitan pizzas baked on our mobile pizza truck</li></ul><p>Optional add-ons include Caprese skewers, salad, and cannoli.</p>'],
  ['What is the minimum to hire you?', '<p>Please visit our <a href="/pricing">pricing page</a> for details on all packages.</p>'],
  ['What’s the setup process for your pizza food truck?', '<p>Our process is simple. We arrive 2–4 hours before service (depending on event size and details) to set up and begin prep. Service is buffet-style: guests choose their pizzas and sides with staff assistance, and pizzas are baked fresh and replenished continuously. After service, we handle cleanup and head out.</p>'],
  ['Do you travel outside Raleigh-Durham for pizza catering?', '<p>Yes. Soci Pizza is based in the Triangle and regularly serves Raleigh, Durham, Chapel Hill, Cary, Pittsboro, Apex, Hillsborough, and surrounding areas. We also travel for select events outside the Triangle, including Charlotte and other North Carolina destinations.</p><p>If you\'re outside our typical service area, contact book@socipizza.com for a custom travel quote.</p>'],
  ['What if it rains or weather is bad?', '<p>We can typically operate in light rain using our truck and tents. If severe weather (such as heavy rain or high winds) makes service unsafe, we\'ll work with you to reschedule, subject to availability. We also recommend having a nearby covered backup area where we can safely operate if needed.</p>'],
  ['Can I cancel or reschedule my pizza truck booking?', '<p>If you need to reschedule, your deposit may be transferred to a new date (subject to availability) with at least 7 days’ notice. One reschedule per booking is allowed.</p><p>All deposits are non-refundable. This is because deposits secure your date and allow us to turn away other requests, so backing out affects our ability to book other customers.</p>'],
];
---
<Base
  title="Pizza Truck Catering for Weddings, Parties, & Corporate Events"
  description="Soci Pizza's vintage Italian pizza truck creates memorable weddings, parties, and corporate events in the Raleigh-Durham area. Reserve our pizza truck today!"
>
  <!-- Hero -->
  <section class="hero bg-cream">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <Rating />
        <h1><span class="red"><strong>Pizza truck catering</strong></span><strong> for weddings and and private parties.</strong></h1>
        <h4>Trusted with 100+ guests at <a target="_blank" rel="noopener" href="https://www.wral.com/lifestyles/wral-lighting-towers-raleigh-durham-rocky-mount/">WRAL Media</a> &amp; <a target="_blank" rel="noopener" href="https://chrislovesjulia.com/">Chris Loves Julia</a>, serving Raleigh-Durham, Charlotte &amp; select North Carolina destinations.</h4>
        <div class="hero-cta">
          <a href="/book-now" class="btn btn-lg">Reserve your date</a>
          <p class="btn-note">✓ Tasting available ✓ Stress-free</p>
        </div>
      </div>
      <div class="hero-img">
        <img src={sized(img.heroTruck, 1500)} alt="Soci pizza truck providing pizza truck catering on the road in Raleigh-Durham, North Carolina, surrounded by green trees, for weddings, parties, and corporate events." width="855" height="1147" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Event types -->
  <section class="section bg-white">
    <div class="wrap">
      <div class="center intro events-intro">
        <h2><strong>A memorable pizza moment for brides &amp; hosts</strong></h2>
        <h4 class="sub"><span>Elevate your event</span> with our vintage Italian pizza truck.</h4>
      </div>
      <div class="events">
        <div class="event">
          <a href="/weddings" class="event-img"><img src={sized(img.cardWeddings, 750)} alt="Soci pizza truck with bride and groom in Carrboro, NC." loading="lazy" /></a>
          <div><h3><a href="/weddings">Rehearsal dinners &amp; weddings</a></h3>
          <p>Perfect for weddings and rehearsal dinners in Raleigh-Durham, Charlotte, and beyond.</p></div>
        </div>
        <div class="event">
          <a href="/parties" class="event-img"><img src={sized(img.cardParties, 750)} alt="A backyard engagement party in Hillsborough, NC with Soci Pizza." loading="lazy" /></a>
          <div><h3><a href="/parties">Parties &amp; private celebrations</a></h3>
          <p>Our mobile pizza truck brings a great vibe to any party in the Triangle and select NC cities.</p></div>
        </div>
        <div class="event">
          <a href="/corporate" class="event-img"><img src={sized(img.cardCorporate, 750)} alt="Corporate pizza catering by Soci Pizza in Raleigh, NC." loading="lazy" /></a>
          <div><h3><a href="/corporate">Corporate lunch pizza catering</a></h3>
          <p>Freshly made on-site pizza for team lunches or client events.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <PricingSection />

  <!-- Instagram -->
  <Instagram sub="See recent events, pizza shots, and behind the scenes from Raleigh-Durham, Charlotte, and select destinations across North Carolina." />

  <!-- FAQ -->
  <Faq title="Pizza catering FAQ" items={faqs} />

  <!-- CTA -->
  <Cta />
</Base>

<style>
  .hero { padding: 3.4vw 0 8.7vw; }
  .hero-grid { display: grid; grid-template-columns: 37.9vw 41.8vw; column-gap: 4.65vw; align-items: center; }
  .hero h1 { margin-bottom: 0.35em; }
  .hero h4 a { color: var(--green); }
  .hero-cta { display: flex; flex-direction: column; width: 22.5vw; margin-top: 10px; }
  .hero-cta .btn { width: 100%; }
  .hero-img img { width: 100%; height: calc(15vw + 428px); object-fit: cover; border-radius: 16px; }
  .hero-cta .btn-note { text-align: center; }

  .intro { margin: 0 auto 5.2vw; }
  .events-intro h2 { max-width: 45.3vw; margin: 0 auto 0.3em; }
  .events-intro .sub { font-size: var(--fs-h4); }
  .events { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5.2vw; width: 76.4vw; margin: 0 auto; }
  .event img { width: 100%; height: calc(12vw + 23px); object-fit: cover; border-radius: 12px; margin-bottom: 35px; }
  .event h3 a { color: var(--green); }
  .event h3 { color: var(--green); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; font-weight: 700; margin-bottom: 0.9em; }

  @media (max-width: 767px) {
    /* Live order on phones: rating, title, text, landscape photo, button, note */
    .hero { padding: 28px 0 59px; }
    .hero-grid { display: flex; flex-direction: column; align-items: stretch; }
    .hero-text { display: contents; }
    .hero-text :global(.rating) { order: 1; margin-bottom: 7px; }
    .hero h1 { order: 2; margin-bottom: 10px; }
    .hero h4 { order: 3; margin-bottom: 10px; }
    .hero-img { order: 4; }
    .hero-img img { height: auto; aspect-ratio: 343 / 296; }
    .hero-cta { order: 5; width: 100%; min-width: 0; margin-top: 44px; }
    .hero-cta .btn-note { margin-top: 10px; }

    .events-intro { margin-bottom: 38px; }
    .events-intro h2 { max-width: none; margin-bottom: 5px; }
    .events { grid-template-columns: 1fr; width: 100%; gap: 62px; }
    .event { display: grid; grid-template-columns: 30vw 1fr; column-gap: 19px; align-items: start; }
    .event img { width: 100%; height: auto; aspect-ratio: 117 / 143; margin: 0; }
    .event h3 { margin-bottom: 4px; }
    .event p { margin: 0; }
  }
</style>
