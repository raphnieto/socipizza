---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';

const reasons: [string, string][] = [
  ['1. Show-stopping experience for your guests', 'From backyard weddings to rustic barns, our vintage mini pizza food truck creates a fun, memorable centerpiece your guests will love.'],
  ['2. Stress-free catering for 100+ guests', 'We keep the pizza flowing smoothly, so you can relax and enjoy your day, No bottlenecks, no surprises. Call us to learn about our service flow.'],
  ['3. Custom menus that match your vibe', 'Our menu is very popular but we are flexible! Depending on availability we work with you to create a pizza catering menu that fits your event.'],
  ['4. Neapolitan pizza with a gourmet touch', 'Our 72-hour dough, made with Guglhupf and local + Italian ingredients, delivers unforgettable flavor you and your guests will remember.'],
  ['5. Transparent worry-free pricing', 'Gratuity is welcome but not mandatory. We have no hidden fees, so you can plan confidently and focus on your celebration.'],
];

const faqs: [string, string][] = [
  ['Can you really serve 100+ people from a tiny truck?', '<p>Absolutely! Depending on your wedding size, we set up additional pizzaiolo stations and multiple ovens to keep the crowd fed quickly and efficiently. We also bring servers to help the lines move smoothly, so you can just relax and enjoy your day. Our wedding pizza food truck may be compact, but it’s designed to make the most of its space, giving you a charming, small-footprint setup without compromising on speed or quality.</p>'],
  ['Do you offer wedding pizza tastings?', '<p>Tastings are available <strong>for booked couples or serious inquiries</strong>, depending on availability and schedule. Many couples move forward based on reviews and photos, but we’re happy to discuss tastings during the planning process if it’s important to you.</p>'],
  ['How much does it cost to hire you for a wedding?', '<p>Please visit our <a href="/pricing">pricing page</a> for details on all packages.</p>'],
  ['Do you need power or water for the pizza truck?', '<p>Nope! Our pizza food truck is fully self-contained, with its own water supply and a quiet, compact generator. That means we can serve fresh pizza almost anywhere. no venue hookups required. Perfect for outdoor weddings across Raleigh-Durham, Charlotte, and select destinations throughout North Carolina.</p>'],
  ['What’s included in your wedding pizza catering packages?', '<p>We’ll work with you to customize your pizza catering experience, and every package includes:</p><ul><li>The right amount of staff members</li><li>Full setup and cleanup</li><li>Unlimited fresh Neapolitan pizzas</li><li>Napkins, plates, and utensils</li></ul><p>Optional add-ons include Caprese skewers, salad, and cannoli.</p>'],
  ['How far in advance should we book wedding pizza catering?', '<p>Reach out anytime, but we recommend booking our vintage pizza truck at least 2–3 months in advance, especially for weekends, weddings, and peak spring–summer dates in Raleigh-Durham, Charlotte, and select destinations across North Carolina.</p>'],
  ['What happens if it rains on our wedding day?', '<p>We can typically operate in light rain using appropriate coverings. If severe weather (such as heavy rain or high winds) makes service unsafe, we\'ll work with you to reschedule, subject to availability. We also recommend having a nearby covered backup area where we can safely operate if needed.</p>'],
];
---
<Base
  title="Wedding Pizza Catering in Raleigh, Durham & Chapel Hill — Soci Pizza"
  description="Mobile wedding pizza catering with a vintage Italian pizza truck. Authentic Neapolitan pizzas made with 72-hour dough for weddings in Raleigh, Durham, Chapel Hill, Charlotte & select North Carolina destinations."
>
  <Landing
    hero={{ img: '/images/weddings.webp', alt: '', tall: true, wide: true,
      h1: '<span class="red"><strong>Neapolitan wedding pizza</strong></span><strong> inspired by what you love.</strong>',
      h4: 'From backyards to rustic barns, we serve 100+ guests smoothly in Raleigh-Durham, Charlotte &amp; select North Carolina destinations.',
      btn: 'Start the conversation', note: '✓ Tasting available ✓ Stress-free' }}
    reviews={{ h2: 'Triangle couples love us ❤️', h3: 'Real reviews from people who trusted Soci Pizza.', lastLink: 'https://share.google/YkZVDjftb8AB2oncS' }}
    five={{ h2: '5 reasons couples choose Soci Pizza for their big day', h3: 'The pizza truck for couples who want more than pizza.',
      img: '/images/private-wedding-pizza-truck-raleigh-nc.webp', aspect: '593 / 530', reasons }}
    instaSub="See real pizza catering service, private events, and behind-the-scenes moments across Raleigh-Durham, Charlotte, and select North Carolina destinations."
    faq={{ title: 'Wedding pizza FAQ', items: faqs }}
  />
</Base>
